{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "engine/shell/**/*.ts",
    "engine/platform/browser/**/*.ts",
    "engine/platform/tauri/**/*.ts",
    "plugins/systems/*/ui/**/*.ts",
    "app/desktop/*.ts"
  ],
  "exclude": ["app/desktop/vite.config.ts"]
}
