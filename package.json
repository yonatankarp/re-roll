{
  "name": "re-roll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "imports": {
    "#sdk": "./engine/sdk/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.test.json && tsc -p tsconfig.ui.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude '.claude/**'",
    "check-pack": "node app/cli/check-pack.ts",
    "check-pack:fixtures": "node tests/check-fixtures.ts",
    "prep:eval": "node tests/prep-eval.ts",
    "bot:fixtures": "node tests/bot-fixtures.ts",
    "bot": "node app/cli/bot.ts",
    "play": "node app/cli/play.ts",
    "ui": "vite --config app/desktop/vite.config.ts",
    "ui:build": "vite build --config app/desktop/vite.config.ts",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "import": "node app/cli/import.ts",
    "import:eval": "node tests/import-eval.ts"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
