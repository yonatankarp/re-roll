{
  "name": "re-roll",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "imports": {
    "#sdk": "./engine/sdk/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.test.json && tsc -p tsconfig.ui.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:soak": "vitest run --project soak",
    "test:coverage": "vitest run --project unit --coverage",
    "check-bundle": "node app/cli/check-bundle.ts",
    "test:ui": "playwright test",
    "check-pack": "node app/cli/check-pack.ts",
    "check-pack:fixtures": "node tests/check-fixtures.ts",
    "prep:eval": "node tests/prep-eval.ts",
    "bot:fixtures": "node tests/bot-fixtures.ts",
    "bot": "node app/cli/bot.ts",
    "bot:check": "node app/cli/bot.ts 200 --check",
    "play": "node app/cli/play.ts",
    "ui": "vite --config app/desktop/vite.config.ts",
    "ui:build": "vite build --config app/desktop/vite.config.ts",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "import": "node app/cli/import.ts",
    "import:eval": "node tests/import-eval.ts",
    "store:pack": "node app/cli/store-pack.ts",
    "narrate": "node app/cli/narrate.ts",
    "class-features": "node tests/class-features.ts"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.5.0",
    "@playwright/test": "1.64.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@tauri-apps/plugin-fs": "2.7.1",
    "@types/node": "26.6.6",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "kokoro-js": "1.2.1",
    "three": "0.186.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "fsevents": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "sharp": false
  },
  "overrides": {
    "minimatch": "11.0.1",
    "sharp": "0.35.5"
  }
}
