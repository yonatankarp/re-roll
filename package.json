{
  "name": "re-roll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "imports": {
    "#sdk": "./engine/sdk/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check-pack": "node app/cli/check-pack.ts",
    "check-pack:fixtures": "node tests/check-fixtures.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
