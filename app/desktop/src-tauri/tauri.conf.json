{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Re-roll",
  "identifier": "app.re-roll.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5199",
    "frontendDist": "../../../out/desktop",
    "beforeDevCommand": "npm run ui",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Re-roll",
        "width": 1100,
        "height": 800,
        "minWidth": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost blob: https://huggingface.co https://*.hf.co; img-src 'self' blob:"
    }
  },
  "bundle": { "active": false }
}
